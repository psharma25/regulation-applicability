{
  "name": "Regulation Applicability Codespace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8501, 8000],
  "postCreateCommand": "bash test/llm-rag-approval/start.sh || true",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-azuretools.vscode-docker"
  ],
  "remoteUser": "vscode"
}
